{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept frontmatter",
  "type": "object",
  "required": ["title", "type", "phase", "tags", "sources", "status", "last_reviewed"],
  "properties": {
    "title": { "type": "string" },
    "type": { "enum": ["mental-model", "principle", "technique", "tool", "framework", "anti-pattern", "workflow"] },
    "phase": {
      "type": "array",
      "items": { "enum": ["planning", "decomposition", "implementation", "review", "qa"] }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "enum": ["draft", "stable", "contested", "deprecated"] },
    "superseded_by": { "type": ["string", "null"] },
    "last_reviewed": { "type": "string", "format": "date" },
    "referenced_by": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(concept|playbook):[a-z0-9-]+$" },
      "description": "Computed by skills/rebuild-frontmatter. Slugs of concepts/playbooks that cite this concept, prefixed with concept: or playbook:."
    },
    "audience": {
      "type": "array",
      "items": { "enum": ["planner", "implementer", "reviewer"] },
      "minItems": 1,
      "description": "Which agent role(s) this concept is most useful to."
    },
    "activate_when": {
      "type": "string",
      "description": "One-sentence trigger: when an agent should pull this concept."
    },
    "counter_to": {
      "type": ["string", "null"],
      "description": "Optional. Slug of the positive concept this anti-pattern pairs against."
    },
    "cluster": {
      "enum": ["context-management", "agent-skill-design", "afk-loops", "decomposition", "review-gates", "pre-ai-foundations", "kb-curation", "tooling-aci"],
      "description": "Optional. Single cluster this concept belongs to."
    }
  },
  "additionalProperties": false
}
